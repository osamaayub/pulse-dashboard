# Optional. Without it, the app uses a built-in demo database (PGlite) that resets on restart.
# Any PostgreSQL works: local, Neon, Supabase, Railway, RDS...
DATABASE_URL=postgres://user:password@localhost:5432/pulse

# Sample data is replaced with a fresh copy this often (hours). 0 turns it off.
# Only the app's own sample store (all @example.com customers) is ever reset, never real data.
# DEMO_RESET_HOURS=24

# Google OAuth for admin access (create a Google OAuth web client).
# Add http://localhost:3000/api/auth/callback/google to authorized redirect URIs.
# AUTH_SECRET should be a long random value generated with: npx auth secret
# ADMIN_EMAILS is the comma-separated bootstrap admin allowlist. Existing admins can
# invite more verified Google accounts from Admin > Team.
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
# Set AUTH_TRUST_HOST=true only when your trusted hosting proxy requires it.
