# Optional. Without it, the app uses a built-in demo database (PGlite) that resets on restart.
# Any PostgreSQL works: local, Neon, Supabase, Railway, RDS...
DATABASE_URL=postgres://user:password@localhost:5432/pulse

# Sample data is replaced with a fresh copy this often (hours). 0 turns it off.
# Only the app's own sample store (all @example.com customers) is ever reset, never real data.
# DEMO_RESET_HOURS=24
